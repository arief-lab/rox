{
  "name": "aaaaaal",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next": "^16.3.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "@orpc/server": "^1.14.12",
      "@orpc/client": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "@orpc/tanstack-query": "^1.14.12",
      "@tanstack/react-query": "^5.101.4",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @aaaaaal/db --",
    "db:studio": "turbo run db:studio -F @aaaaaal/db --",
    "db:generate": "turbo run db:generate -F @aaaaaal/db --",
    "db:migrate": "turbo run db:migrate -F @aaaaaal/db --",
    "db:local": "turbo run db:local -F @aaaaaal/db --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@aaaaaal/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@aaaaaal/config": "workspace:*",
    "@biomejs/biome": "2.5.9",
    "@types/node": "catalog:",
    "husky": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.10.7"
  },
  "packageManager": "bun@1.4.0"
}
