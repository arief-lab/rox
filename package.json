{
	"name": "rox",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/node": "^26.2.0",
			"lucide-react": "^1.27.0",
			"next": "^16.3.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.7",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:native": "turbo run dev -F native --",
		"dev:web": "turbo run dev -F web --",
		"dev:desktop": "turbo run dev -F desktop --",
		"check": "ultracite check",
		"fix": "ultracite fix",
		"test": "turbo run test",
		"prepare": "husky"
	},
	"dependencies": {
		"@rox/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.9",
		"@rox/config": "workspace:*",
		"@types/node": "catalog:",
		"husky": "latest",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"typescript6": "npm:@typescript/typescript6@^6.0.2",
		"ultracite": "7.10.7",
		"websockets": "^0.2.0"
	},
	"packageManager": "bun@1.4.0"
}
