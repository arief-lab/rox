{
  "name": "rox",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next": "^16.3.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev -F desktop --",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev -F web --",
    "fix": "ultracite fix",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "dependencies": {
    "@rox/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@rox/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript6": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.10.7",
    "websockets": "^0.2.0"
  },
  "packageManager": "bun@1.4.0"
}
