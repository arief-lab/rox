{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/next"],
  "linter": {
    "rules": {
      "a11y": {
        // packages/ui/src/components/label.tsx is a generic shadcn-style
        // component; callers decide whether to provide htmlFor or children.
        "noLabelWithoutControl": "off"
      }
    }
  },
  "overrides": [
    {
      // The two pairing screens inline three render branches
      // (idle / offering|pasting / connected for the offerer,
      // idle / scanning / connected for the answerer) so the
      // pairing-flow narrative reads top-to-bottom in one file.
      // Extracting each branch into a sub-component would split
      // the story across files and is tracked as a follow-up.
      // Until then, allow the higher cognitive complexity.
      "includes": [
        "apps/web/src/components/pairing-screen.tsx",
        "apps/web/src/components/answerer-screen.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": { "maxAllowedComplexity": 25 }
            }
          }
        }
      }
    }
  ]
}
