#!/bin/sh
# Format + lint only the staged files (fast, repo-wide checks stay in CI).
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to check"
  exit 0
fi

bunx @biomejs/biome check --staged --write
BIOME_EXIT=$?

# Exit 2 means "no files processed" — every staged file is Biome-ignored
# (e.g. a markdown-only commit). That is success, not failure.
if [ $BIOME_EXIT -eq 2 ]; then
  echo "All staged files are Biome-ignored — nothing to check"
  exit 0
fi

if [ $BIOME_EXIT -ne 0 ]; then
  echo ""
  echo "Biome found issues that could not be auto-fixed in staged files."
  echo "Run: bun x ultracite fix  (or fix them manually), then re-stage."
  exit $BIOME_EXIT
fi

# Re-stage files that biome may have rewritten
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

echo "✨ Staged files formatted by Biome"
