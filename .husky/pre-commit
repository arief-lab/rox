#!/bin/sh
# Format + lint only the staged files (fast, repo-wide checks stay in CI).
# Only pass files Biome can process — markdown/docs etc. are skipped, so a
# docs-only commit succeeds without "no files were processed" errors.
# (grep exits 1 on no-match, which would trip husky's `sh -e` — hence || true)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|mts|cts|json|jsonc|css|scss|less|graphql|gql|html|vue|svelte|astro)$' || true)
if [ -z "$STAGED_FILES" ]; then
  echo "No Biome-checkable files staged"
  exit 0
fi

bunx @biomejs/biome check --staged --write
BIOME_EXIT=$?

if [ $BIOME_EXIT -ne 0 ]; then
  echo ""
  echo "Biome found issues that could not be auto-fixed in staged files."
  echo "Run: bun x ultracite fix  (or fix them manually), then re-stage."
  exit $BIOME_EXIT
fi

# Re-stage files that biome may have rewritten
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    git add -- "$file"
  fi
done

echo "✨ Staged files formatted by Biome"
