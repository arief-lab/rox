# Desktop (Electron main process) env — copy to .env and adjust.
# Loaded by main/env.ts at startup; validated by @rox/env/desktop.

# Appends a suffix to the Electron userData dir so multiple instances
# (e.g. pairing smoke tests) don't contend over the Corestore lock.
# Leave unset for normal single-instance use.
# ROX_USER_DATA_SUFFIX=test-a
